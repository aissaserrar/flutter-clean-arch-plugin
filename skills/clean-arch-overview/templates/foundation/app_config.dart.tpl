/// App-wide config (flavors, mock flags). Generated by /foundation.
/// Wire real values from `--dart-define` / flavor setup in /di.
class AppConfig {
  const AppConfig({
    required this.environment,
    this.useMocks = false,
  });

  final String environment;
  final bool useMocks;

  static AppConfig? _instance;
  static AppConfig get instance =>
      _instance ?? (throw StateError('AppConfig.init was not called'));

  static void init(AppConfig config) {
    _instance = config;
  }
}
